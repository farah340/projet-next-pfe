model ZoneActivite {
  id               String       @id @default(cuid())
  
  zoneId           String
  zone             Zone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  
  typeActiviteId   String
  typeActivite     TypeActivite @relation(fields: [typeActiviteId], references: [id], onDelete: Cascade)

  createdAt        DateTime     @default(now())

  @@unique([zoneId, typeActiviteId])
}