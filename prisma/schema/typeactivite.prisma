model TypeActivite {
  id          String   @id @default(cuid())
  nom         String    

   
  radius       Int      @default(1500)   
  actif        Boolean  @default(true) 

  icone       String?  

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  zones       ZoneActivite[]
  categories  Categorie[]
}
