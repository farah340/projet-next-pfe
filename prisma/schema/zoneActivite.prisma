model ZoneActivite {
  id             String       @id @default(cuid())
  zoneId         String
  typeActiviteId String
  createdAt      DateTime     @default(now())
  typeActivite   TypeActivite @relation(fields: [typeActiviteId], references: [id], onDelete: Cascade)
  zone           Zone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, typeActiviteId])
}
