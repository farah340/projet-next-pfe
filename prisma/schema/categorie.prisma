model Categorie {
  id             String       @id @default(uuid())
  name           String
  google_type    String
  keywords       String[]
  typeActiviteId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  typeActivite   TypeActivite @relation(fields: [typeActiviteId], references: [id], onDelete: Cascade)
}
