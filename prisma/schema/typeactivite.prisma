model TypeActivite {
  id         String         @id @default(cuid())
  nom        String
  icone      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  actif      Boolean        @default(true)
  radius     Int            @default(1500)
  categories Categorie[]
  zones      ZoneActivite[]
}
