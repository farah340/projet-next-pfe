// This file imports all schema files from the schema directory
// Prisma will process this as a single schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Import all models from schema directory
// Note: This is a workaround - Prisma doesn't natively support file imports
// We need to concatenate all schema files here

// From base.prisma (already included above)

// From user.prisma
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  nom       String
  password  String
  telephone String?
  role      Role     @default(USER)
  emailVerified DateTime?
  customRoleId  String?
  customRole    CustomRole? @relation(fields: [customRoleId], references: [id])

  firstLogin    Boolean   @default(true)
  lastLogin     DateTime? @default(now())
  accounts      Account[]
  sessions      Session[]
  zones         Zone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum Role {
  ADMIN
  USER
}

// From zone.prisma
model Zone {
  id          String   @id @default(cuid())
  nom         String
  description String?

  // Données géographiques
  adresse     String   // Nom affiché de la ville/région
  lat         Float
  lng         Float
  geojson     Json?    // Frontières officielles GeoJSON

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// From account.prisma
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// From session.prisma
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// From VerificationToken.prisma
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// From customRole.prisma
model CustomRole {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  permissions Permission[]
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// From permission.prisma
model Permission {
  id            String      @id @default(cuid())
  name          String      @unique
  description   String?
  resource      String
  action        String
  customRoles   CustomRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}